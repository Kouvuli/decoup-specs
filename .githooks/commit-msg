#!/bin/sh
set -eu
subject=$(head -n 1 "$1")
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$'; then
    echo 'Use Conventional Commits: type(scope): description, e.g. feat(booking): add availability' >&2
    exit 1
fi
